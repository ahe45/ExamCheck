# API
NODE_ENV=development
PORT=3100
# Optional comma-separated allowlist. When non-empty, this takes precedence over FRONTEND_ORIGIN.
FRONTEND_ORIGINS=
# Backward-compatible single-origin setting.
FRONTEND_ORIGIN=http://localhost:5173

# MySQL (local .env uses the U-Form server settings with a separate database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Enter the real database password. On Windows MariaDB, an empty or incorrect
# password may fall back to unsupported auth_gssapi_client authentication.
# Quote passwords containing #, for example DB_PASSWORD="your#password".
DB_PASSWORD=
DB_NAME=examcheck
DB_CONNECTION_LIMIT=10
DEFAULT_EXAM_NAME=2026년도 자격시험

# Authentication (production JWT_SECRET: at least 32 random bytes encoded as base64url)
# Example generation: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=replace-with-a-long-random-secret
JWT_SESSION_TTL_SECONDS=28800
JWT_ISSUER=examcheck-api
JWT_AUDIENCE=examcheck-web
JWT_CLOCK_TOLERANCE_SECONDS=30
ADMIN_INITIAL_PASSWORD=1234
USER_INITIAL_PASSWORD=1234
DEVELOPER_INITIAL_PASSWORD=1234
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=900
AUTH_LOGIN_MAX_TRACKED_KEYS=10000

# Printing policy
PRINT_JOB_EXPIRY_SECONDS=300

# Target identity transition. Keep disabled until an approved backfill has completed.
IDENTITY_TRANSITION_ENABLED=false
# Required before SHADOW/CANARY reads; use at least 32 random bytes and do not commit the real value.
IDENTITY_SHADOW_HMAC_SECRET=

# Web
# Use the same server address as the web page; Vite forwards /api to the API PORT.
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_EXAM_NAME=2026년도 자격시험
VITE_PRINTER_MODE=browser-print
# 운영 PC별로 서버에 등록된 워크스테이션 코드를 지정합니다.
VITE_WORKSTATION_CODE=WS-DEV-001

# Optional request/database performance measurements (no SQL parameters).
EXAMCHECK_PERFORMANCE_METRICS=0
