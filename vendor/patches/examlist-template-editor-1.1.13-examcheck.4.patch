@@ -233,3 +233,45 @@ export function normalizeCandidateBlockBoundaryHostHtml(value = "") {
 export function isBlankCandidateBlockBoundaryHost(element) {
   return normalizeCandidateBlockBoundaryHostHtml(element?.innerHTML || "") === "";
 }
+
+// Delete only the editable blank tail, never let the browser merge it into a
+// noneditable grid or its temporary flow spacer.
+export function deleteCandidateBlockTrailingBlankParagraphs(event, surfaceElement) {
+  if (!["Backspace", "Delete"].includes(event.key) || event.ctrlKey || event.metaKey || event.altKey) return null;
+  const root = surfaceElement?.querySelector?.(".template-doc");
+  const selection = surfaceElement?.ownerDocument?.defaultView?.getSelection?.();
+  const range = selection?.rangeCount ? selection.getRangeAt(0) : null;
+  if (!root || !range || !root.contains(range.startContainer) || !root.contains(range.endContainer)) return null;
+  const tail = [];
+  let previous = root.lastElementChild;
+  while (previous?.matches("p") && isBlankCandidateBlockBoundaryHost(previous)) {
+    tail.unshift(previous);
+    previous = previous.previousElementSibling;
+  }
+  if (previous?.matches("[data-template-object-flow-spacer]")) previous = previous.previousElementSibling;
+  if (!previous?.matches(CANDIDATE_BLOCK_GRID_SELECTOR) || !tail.length) return null;
+  const boundaryHost = (node, offset, end) => node === root
+    ? root.childNodes[offset - (end ? 1 : 0)]
+    : (node.nodeType === TEXT_NODE ? node.parentElement : node)?.closest?.("p");
+  const startHost = boundaryHost(range.startContainer, range.startOffset, false);
+  const endHost = range.collapsed ? startHost : boundaryHost(range.endContainer, range.endOffset, true);
+  if (!tail.includes(startHost) || !tail.includes(endHost)) return null;
+  const startIndex = tail.indexOf(startHost);
+  let removed;
+  if (range.collapsed) {
+    const target = event.key === "Backspace" ? startHost : tail[startIndex + 1];
+    removed = tail.length > 1 && target ? [target] : [];
+  } else {
+    removed = tail.filter((paragraph) => range.intersectsNode(paragraph));
+    if (removed.length === tail.length) removed = removed.slice(1);
+  }
+  const caretHost = tail[Math.max(0, startIndex - (event.key === "Backspace" ? 1 : 0))];
+  removed.forEach((paragraph) => paragraph.remove());
+  const survivingHost = caretHost.isConnected ? caretHost : tail.find((paragraph) => paragraph.isConnected);
+  const caret = root.ownerDocument.createRange();
+  caret.selectNodeContents(survivingHost);
+  caret.collapse(true);
+  selection.removeAllRanges();
+  selection.addRange(caret);
+  return { changed: removed.length > 0 };
+}
