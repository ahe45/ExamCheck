diff --git a/src/runtime/index.js b/src/runtime/index.js
index 8402d7d..2db1399 100644
--- a/src/runtime/index.js
+++ b/src/runtime/index.js
@@ -649,13 +649,26 @@ export function mountTemplateEditor(options = {}) {
 
     if (nextHtml !== rawHtml) {
       runtimeChangeNormalizationDepth += 1;
+      const historyState = rawRuntimeApi.state.templateEditor;
+      const wasRestoringHistory = historyState.isRestoringHistory;
+      const currentSnapshot = historyState.historyEntries[historyState.historyIndex];
+      // Canonicalizing HTML (for example a trailing style semicolon) is part of
+      // the same edit. getHtml() synchronizes the surface, so suppress its extra
+      // snapshot and canonicalize the existing entry. Otherwise undo restores
+      // the raw entry, normalization adds it again, and undo can never advance.
+      historyState.isRestoringHistory = true;
 
       try {
         withoutSetHtmlCallback(() => {
           rawRuntimeApi.setHtml(nextHtml, { notify: false, resetHistory: false });
         });
-        nextHtml = sanitizeResolvedHtml(rawRuntimeApi.getHtml(), options.document || globalThis.document, options);
+        const canonicalHtml = rawRuntimeApi.getHtml();
+        if (currentSnapshot?.html === rawHtml) {
+          currentSnapshot.html = canonicalHtml;
+        }
+        nextHtml = sanitizeResolvedHtml(canonicalHtml, options.document || globalThis.document, options);
       } finally {
+        historyState.isRestoringHistory = wasRestoringHistory;
         runtimeChangeNormalizationDepth -= 1;
       }
     }
