{
  "name": "examcheck",
  "version": "0.1.0",
  "description": "가번호 관리 시스템 - Zebra GT800 웹 라벨 출력",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @examcheck/web\" \"npm run dev -w @examcheck/api\"",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"apps/**/*.{ts,tsx}\" --fix --max-warnings=0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,md}\" \"e2e/**/*.{js,mjs,ts,tsx}\" \".github/**/*.{yml,yaml}\" \"*.{js,ts,json,md}\" \"docs/**/*.md\" .prettierrc",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,md}\" \"e2e/**/*.{js,mjs,ts,tsx}\" \".github/**/*.{yml,yaml}\" \"*.{js,ts,json,md}\" \"docs/**/*.md\" .prettierrc",
    "build": "npm run build -w @examcheck/api && npm run build -w @examcheck/web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:list": "node e2e/run.mjs --list",
    "test:e2e:smoke": "node e2e/run.mjs --project=hd --project=hd-plus --project=fhd --project=qhd --project=workflow-fhd",
    "test:visual": "node e2e/run.mjs visual.spec.ts --project=visual-fhd --project=visual-qhd",
    "test:visual:update": "node e2e/run.mjs visual.spec.ts --project=visual-fhd --project=visual-qhd --update-snapshots=all",
    "test:integration": "npm run test:integration -w @examcheck/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:integration": "npm run typecheck:integration -w @examcheck/api",
    "metrics:baseline": "node tools/metrics/collect-baseline.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:integration && npm test && npm run build",
    "check:full": "npm run check && npm run test:coverage && npm run test:e2e",
    "check:integration": "npm run check:integration -w @examcheck/api",
    "db:setup": "npm run db:setup -w @examcheck/api",
    "db:migrate": "npm run db:migrate -w @examcheck/api",
    "db:bootstrap": "npm run db:bootstrap -w @examcheck/api"
  },
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "examlist-template-editor": "file:vendor/examlist-template-editor-1.1.2.tgz"
  }
}
